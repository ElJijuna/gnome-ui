{
  "name": "@gnome-ui/website",
  "version": "0.1.0",
  "description": "Component showcase site for the GNOME UI monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-registry.mjs",
    "dev": "npm run generate && vite",
    "build": "npm run generate && tsc6 --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "npm run generate && tsc6 --noEmit && tsc6 --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@gnome-ui/charts": "*",
    "@gnome-ui/core": "*",
    "@gnome-ui/hooks": "*",
    "@gnome-ui/icons": "*",
    "@gnome-ui/layout": "*",
    "@gnome-ui/react": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-live": "^4.1.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.4"
  },
  "author": "pilmee <pilmee@gmail.com> (https://github.com/ElJijuna)",
  "license": "MIT"
}
