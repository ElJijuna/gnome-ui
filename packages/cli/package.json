{
  "name": "@gnome-ui/cli",
  "version": "1.1.0",
  "description": "CLI utilities for keeping GNOME UI packages up to date",
  "type": "module",
  "bin": {
    "gnomeui": "./dist/index.js",
    "gui": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc6 -p tsconfig.json",
    "typecheck": "tsc6 -p tsconfig.json --noEmit && tsc6 -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "blessed": "^0.1.81",
    "blessed-components": "^1.17.0",
    "commander": "^14.0.2",
    "npmjs-api-client": "^1.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.27",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "vitest": "^4.1.4"
  },
  "author": "pilmee <pilmee@gmail.com> (https://github.com/ElJijuna)",
  "license": "MIT"
}
