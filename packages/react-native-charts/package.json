{
  "name": "@gnome-ui/react-native-charts",
  "version": "1.1.0",
  "description": "Data visualisation components for React Native, styled with Adwaita design tokens, rendered on Skia via Victory Native",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc6 && vite build",
    "typecheck": "tsc6 --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@gnome-ui/react-native": "*",
    "@shopify/react-native-skia": ">=2.6.0 <3.0.0",
    "react": "^19.0.0",
    "react-native": ">=0.78.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-worklets": ">=0.7.0",
    "victory-native": ">=42.0.0 <43.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@gnome-ui/react-native": "*",
    "@react-native/babel-preset": "^0.86.2",
    "@react-native/jest-preset": "^0.86.2",
    "@shopify/react-native-skia": "2.6.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react": "^19.0.0",
    "react-native": "^0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "test-renderer": "^1.2.0",
    "victory-native": "^42.0.1",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^4.5.4"
  },
  "author": "pilmee <pilmee@gmail.com> (https://github.com/ElJijuna)",
  "license": "MIT"
}
