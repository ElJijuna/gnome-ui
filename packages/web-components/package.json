{
  "name": "@gnome-ui/web-components",
  "version": "1.3.0",
  "description": "Framework-agnostic GNOME UI Web Components built with native Custom Elements",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./action-row": {
      "types": "./dist/action-row.d.ts",
      "import": "./dist/action-row.js",
      "require": "./dist/action-row.cjs"
    },
    "./avatar": {
      "types": "./dist/avatar.d.ts",
      "import": "./dist/avatar.js",
      "require": "./dist/avatar.cjs"
    },
    "./badge": {
      "types": "./dist/badge.d.ts",
      "import": "./dist/badge.js",
      "require": "./dist/badge.cjs"
    },
    "./banner": {
      "types": "./dist/banner.d.ts",
      "import": "./dist/banner.js",
      "require": "./dist/banner.cjs"
    },
    "./boxed-list": {
      "types": "./dist/boxed-list.d.ts",
      "import": "./dist/boxed-list.js",
      "require": "./dist/boxed-list.cjs"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js",
      "require": "./dist/button.cjs"
    },
    "./card": {
      "types": "./dist/card.d.ts",
      "import": "./dist/card.js",
      "require": "./dist/card.cjs"
    },
    "./checkbox": {
      "types": "./dist/checkbox.d.ts",
      "import": "./dist/checkbox.js",
      "require": "./dist/checkbox.cjs"
    },
    "./dialog": {
      "types": "./dist/dialog.d.ts",
      "import": "./dist/dialog.js",
      "require": "./dist/dialog.cjs"
    },
    "./header-bar": {
      "types": "./dist/header-bar.d.ts",
      "import": "./dist/header-bar.js",
      "require": "./dist/header-bar.cjs"
    },
    "./icon-button": {
      "types": "./dist/icon-button.d.ts",
      "import": "./dist/icon-button.js",
      "require": "./dist/icon-button.cjs"
    },
    "./menu": {
      "types": "./dist/menu.d.ts",
      "import": "./dist/menu.js",
      "require": "./dist/menu.cjs"
    },
    "./popover": {
      "types": "./dist/popover.d.ts",
      "import": "./dist/popover.js",
      "require": "./dist/popover.cjs"
    },
    "./progress-bar": {
      "types": "./dist/progress-bar.d.ts",
      "import": "./dist/progress-bar.js",
      "require": "./dist/progress-bar.cjs"
    },
    "./radio-group": {
      "types": "./dist/radio-group.d.ts",
      "import": "./dist/radio-group.js",
      "require": "./dist/radio-group.cjs"
    },
    "./separator": {
      "types": "./dist/separator.d.ts",
      "import": "./dist/separator.js",
      "require": "./dist/separator.cjs"
    },
    "./skeleton": {
      "types": "./dist/skeleton.d.ts",
      "import": "./dist/skeleton.js",
      "require": "./dist/skeleton.cjs"
    },
    "./slider": {
      "types": "./dist/slider.d.ts",
      "import": "./dist/slider.js",
      "require": "./dist/slider.cjs"
    },
    "./spin-button": {
      "types": "./dist/spin-button.d.ts",
      "import": "./dist/spin-button.js",
      "require": "./dist/spin-button.cjs"
    },
    "./spinner": {
      "types": "./dist/spinner.d.ts",
      "import": "./dist/spinner.js",
      "require": "./dist/spinner.cjs"
    },
    "./switch": {
      "types": "./dist/switch.d.ts",
      "import": "./dist/switch.js",
      "require": "./dist/switch.cjs"
    },
    "./text-field": {
      "types": "./dist/text-field.d.ts",
      "import": "./dist/text-field.js",
      "require": "./dist/text-field.cjs"
    },
    "./toast": {
      "types": "./dist/toast.d.ts",
      "import": "./dist/toast.js",
      "require": "./dist/toast.cjs"
    },
    "./tooltip": {
      "types": "./dist/tooltip.d.ts",
      "import": "./dist/tooltip.js",
      "require": "./dist/tooltip.cjs"
    },
    "./styles": {
      "types": "./src/style.d.ts",
      "default": "./dist/style.css"
    }
  },
  "sideEffects": [
    "dist/*.js",
    "dist/*.cjs",
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/style.d.ts"
  ],
  "scripts": {
    "build": "tsc6 && vite build",
    "typecheck": "tsc6 --noEmit && tsc6 --noEmit -p .storybook/tsconfig.json && tsc6 --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6010",
    "build-storybook": "storybook build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@gnome-ui/core": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/web-components-vite": "10.5.5",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "jsdom": "^29.0.2",
    "lit": "^3.3.3",
    "storybook": "10.5.5",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.4"
  },
  "author": "pilmee <pilmee@gmail.com> (https://github.com/ElJijuna)",
  "license": "MIT"
}
