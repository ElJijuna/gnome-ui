    },
    "./styles": {
      "types": "./src/style.d.ts",
      "default": "./dist/style.css"
    }
  },
  "sideEffects": [
    "dist/*.js",
    "dist/*.cjs",
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/style.d.ts"
  ],
  "scripts": {
    "build": "tsc6 && vite build",
    "typecheck": "tsc6 --noEmit && tsc6 --noEmit -p .storybook/tsconfig.json && tsc6 --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6010",
    "build-storybook": "storybook build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@gnome-ui/core": "*",
    "@gnome-ui/icons": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/web-components-vite": "10.5.5",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "jsdom": "^29.0.2",
    "lit": "^3.3.3",
    "storybook": "10.5.5",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.4"
