  "sideEffects": [
    "**/*.css",
    "dist/style.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc6 && vite build",
    "preview": "vite preview",
    "typecheck": "tsc6 --noEmit && tsc6 --noEmit -p .storybook/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "npm run test:storybook-report:dev && storybook dev -p 6009",
    "build-storybook": "storybook build",
    "test:storybook-report": "vitest run --reporter=json --coverage --outputFile=storybook-reports/vitest-report.json",
    "test:storybook-report:dev": "vitest run --reporter=json --coverage --outputFile=storybook-reports/vitest-report.json",
    "storybook:ci": "npm run test:storybook-report && npm run build-storybook"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@gnome-ui/core": "*",
    "@gnome-ui/icons": "*"
  },
