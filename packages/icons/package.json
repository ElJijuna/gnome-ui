{
  "name": "@gnome-ui/icons",
  "version": "1.43.0",
  "description": "Framework-agnostic icon definitions for gnome-ui",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js",
      "require": "./dist/icons.cjs"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./third-party": {
      "types": "./dist/third-party.d.ts",
      "import": "./dist/third-party.js",
      "require": "./dist/third-party.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "vite-magic validate",
    "build": "tsc6 && vite build",
    "typecheck": "tsc6 --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "npm run test:storybook-report:dev && storybook dev -p 6008",
    "build-storybook": "storybook build",
    "test:storybook-report": "vitest run --reporter=json --coverage --outputFile=storybook-static/vitest-report.json",
    "test:storybook-report:dev": "vitest run --reporter=json --coverage --outputFile=storybook-reports/vitest-report.json",
    "storybook:ci": "npm run build-storybook && npm run test:storybook-report"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.4",
    "vitest": "^4.1.4",
    "@pilmee/storybook-addon-vitest": "^0.1.0",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/react": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.5.5",
    "vite": "^8.0.16",
    "vite-magic-tree-shaking": "^1.0.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "author": "pilmee <pilmee@gmail.com> (https://github.com/ElJijuna)",
  "license": "MIT"
}
