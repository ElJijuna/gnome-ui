{
  "name": "@gnome-ui/react-native",
  "version": "1.2.0",
  "description": "React Native components following the GNOME Human Interface Guidelines, targeting iOS/Android/GNOME-mobile shells",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "theme:generate": "node scripts/generate-theme.mjs && biome check --write src/theme/tokens.generated.ts",
    "build": "npm run theme:generate && tsc6 && vite build",
    "typecheck": "npm run theme:generate && tsc6 --noEmit",
    "test": "npm run theme:generate && jest",
    "test:watch": "npm run theme:generate && jest --watch",
    "test:coverage": "npm run theme:generate && jest --coverage"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@gnome-ui/core": "*",
    "@gnome-ui/icons": "*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.76.0",
    "react-native-svg": ">=15.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/babel-preset": "^0.86.2",
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "postcss": "^8.5.25",
    "react": "^19.0.0",
    "react-native": "^0.86.2",
    "react-native-svg": "15.15.4",
    "test-renderer": "^1.2.0",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^4.5.4"
  },
  "author": "pilmee <pilmee@gmail.com> (https://github.com/ElJijuna)",
  "license": "MIT"
}
