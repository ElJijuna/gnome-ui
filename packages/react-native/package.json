{
  "name": "@gnome-ui/react-native",
  "version": "0.1.0",
  "description": "React Native components following the GNOME Human Interface Guidelines, targeting iOS/Android/GNOME-mobile shells",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "theme:generate": "node scripts/generate-theme.mjs && biome check --write src/theme/tokens.generated.ts",
    "build": "npm run theme:generate && tsc6 && vite build",
    "typecheck": "npm run theme:generate && tsc6 --noEmit",
    "test": "npm run theme:generate && vitest run",
    "test:watch": "npm run theme:generate && vitest",
    "test:coverage": "npm run theme:generate && vitest run --coverage"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@gnome-ui/core": "*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "postcss": "^8.5.25",
    "react": "^19.0.0",
    "react-native": "^0.86.2",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.4"
  },
  "author": "pilmee <pilmee@gmail.com> (https://github.com/ElJijuna)",
  "license": "MIT"
}
